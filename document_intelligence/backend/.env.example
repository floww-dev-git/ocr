# Copy to .env and fill in. .env is gitignored.

# Extraction: `gemini` reads documents for real, `mock` replays canned sample reads.
EXTRACTION_MODE=gemini
GEMINI_API_KEY=your-google-ai-studio-key-here

# Optional — extraction models (mirrors sale_deed_poc's DEED_MODEL convention)
DI_MODEL=gemini-3.1-pro-preview
DI_INVENTORY_MODEL=gemini-3.1-pro-preview
DI_MAX_PAGES=150

# Optional — the mocked Income Tax PAN verification endpoint this backend calls
DI_ITD_PAN_VERIFY_URL=http://127.0.0.1:8000/mock/itd/pan/verify
DI_ITD_TIMEOUT_SECONDS=3.0

# Optional — the mocked issuer's own behaviour. It answers after a lifelike delay,
# requires the api key below, and on a forced timeout waits the caller's budget plus
# the margin so the wait is a genuine overrun rather than a special-cased error.
DI_MOCK_ISSUER_LATENCY_SECONDS=0.9
DI_MOCK_ISSUER_TIMEOUT_MARGIN_SECONDS=1.0
DI_MOCK_ISSUER_API_KEY=poc-itd-demo-key

# Optional — upload limits
DI_MAX_UPLOAD_BYTES=10485760
